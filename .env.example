# Optional defaults for the pii-screen command line. Both can also be given as flags.
# The tool reads these from the process environment; it does not load .env files itself.

# Default mode when --mode is not given: block, redact or tokenise
PII_SCREEN_MODE=tokenise

# Default roster file when --roster is not given: one known name per line
PII_SCREEN_ROSTER=corpus/roster.txt

# No API key is needed. pii-screen never makes a network call. The demo and
# tests use an offline mock model. If you wire in a real model client, keep
# its key in your own environment, not in this repo.
